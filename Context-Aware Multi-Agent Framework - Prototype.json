      "parameters": {
        "jsCode": "const input = $input.all()[0]?.json || {};\nconst anomalyDetected = input.triggerSource === 'anomaly_signal' || !!$node[\"System Trigger 5: Anomaly Signal\"]?.id;\n\nreturn [{\n  json: {\n    telemetry_payload: {\n      signal_alpha: input.signal_alpha || 62,\n      signal_beta: input.signal_beta || 74,\n      signal_gamma: anomalyDetected ? 85 : (input.signal_gamma || 30),\n      metric_weight: input.weight || 75.0,\n      metric_hydration: input.hydration || 60.0\n    },\n    anomaly_override_active: anomalyDetected,\n    direct_command: input.message?.text || \"\",\n    system_timestamp: new Date().toISOString()\n  }\n}];"
