    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst anomalyActive = items[0]?.json?.anomaly_override_active || false;\n\nlet compiledAgents = [];\n\nfor (let i = 0; i < items.length; i++) {\n  let rawOutput = items[i].json.output || \"\";\n  let parsed = {};\n  try {\n    parsed = typeof rawOutput === 'string' ? JSON.parse(rawOutput.replace(/```json|```/g, '')) : rawOutput;\n  } catch (e) {\n    parsed = {\n      agent_id: \"agent_unidentified\",\n      urgency: 3,\n      action_item: rawOutput,\n      timing_window: \"standard\",\n      default_weight: 3\n    };\n  }\n  \n  let agentId = parsed.agent_id || \"specialist\";\n  let defaultWeight = parsed.default_weight || 3;\n  let urgency = parsed.urgency || 3;\n  \n  // Programmatic Anomaly Adjuster\n  if (anomalyActive) {\n    if (agentId === 'agent_social' || agentId === 'agent_regulation') {\n      defaultWeight = 1;\n      urgency = 5;\n    } else if (agentId === 'agent_structural' || agentId === 'agent_cognition') {\n      urgency = 0;\n    }\n  }\n  \n  let timingMultiplier = 1.0;\n  if (parsed.timing_window === 'immediate') timingMultiplier = 2.0;\n  else if (parsed.timing_window === 'optimal') timingMultiplier = 1.5;\n  \n  const finalScore = (6 - defaultWeight) * urgency * timingMultiplier;\n  \n  compiledAgents.push({\n    agent_id: agentId,\n    score: finalScore,\n    action: parsed.action_item,\n    reason: parsed.reasoning,\n    duration: parsed.duration_minutes || 30\n  });\n}\n\ncompiledAgents.sort((a, b) => b.score - a.score);\n\nreturn [{\n  json: {\n    anomaly_override_active: anomalyActive,\n    sorted_agenda: compiledAgents,\n    top_priority_item: compiledAgents[0] || {}\n  }\n}];"
      },
